    <!-- http://purl.obolibrary.org/obo/BFO_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001019"/>
    


