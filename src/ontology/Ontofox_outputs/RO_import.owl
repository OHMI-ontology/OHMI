        <obo:IAO_0000117 xml:lang="en">Person: Jie Zheng, Chris Stoeckert, Alan Ruttenberg</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">The &#39;tracker item&#39; can associate a tracker with a specific ontology term.</rdfs:comment>
