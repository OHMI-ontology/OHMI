        <oboInOwl:hasRelatedSynonym>enthesitis-related arthritis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>juvenile enthesitis-related arthritis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>juvenile spondylarthropathy</oboInOwl:hasRelatedSynonym>
